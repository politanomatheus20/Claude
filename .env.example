# Segredo para assinar a sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Banco. Local: deixe em branco (usa file:./data/app.db).
# Produção (Turso): libsql://<db>-<org>.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Anexos em produção (Vercel Blob). Local: deixe em branco (usa ./data/uploads).
BLOB_READ_WRITE_TOKEN=
